generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Примечания по миграции с PostgreSQL на SQLite:
// - enum → String (значения валидируются в коде, см. src/common/enums.ts)
// - String[] → String (хранится как JSON-массив строк; парсится через
//   parseStringArray() в src/common/json-array.ts)
// - @db.Uuid / @db.VarChar(N) убраны — SQLite их не поддерживает
// - Json / BigInt / DateTime остаются нативными типами Prisma для SQLite
// =============================================================================

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  identityKind String   @default("LOCAL") @map("identity_kind")
  role         String   @default("ADMIN") // UserRole
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  totpSecret   String?  @map("totp_secret")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sites                Site[]
  notificationSettings NotificationSetting[]
  auditLogs            AuditLog[]
  aiSessions           AiSession[]
  backupExports        BackupExport[]
  operations           Operation[]
  remoteOperationLinks RemoteOperationLink[]
  federatedVpnSubscriptions FederatedVpnSubscription[]
  webhookRoutes        WebhookRoute[]
  federatedPrincipal   FederatedPrincipal?

  @@index([identityKind])
  @@map("users")
}

model Site {
  id              String  @id @default(uuid())
  // `name` — системное имя (= общий Linux-юзер и стабильный legacy runtime key
  // primary domain). Уникально, [a-z0-9_-], max 32 символов.
  name            String  @unique
  displayName     String? @map("display_name")
  // Global Site/container state. Per-application state lives on SiteDomain.
  status          String  @default("STOPPED") // SiteStatus
  errorMessage    String? @map("error_message")
  rootPath        String  @map("root_path")
  nginxConfigPath String  @map("nginx_config_path")
  systemUser      String? @map("site_user")
  /// AES-256-GCM, HKDF(master,'meowbox:ssh:v1'). См. spec master-key-unification.
  sshPasswordEnc  String? @map("ssh_password_enc")

  // Per-site дефолтные excludes для бэкапов (JSON string[]). Пустой массив или
  // null — fallback на глобальные дефолты из panel_settings.backup-defaults.
  backupExcludes      String?  @map("backup_excludes")
  // Per-site список таблиц БД, которые дампятся БЕЗ данных (только структура).
  // JSON string[]. null/[] — fallback на глобальные.
  backupExcludeTables String?  @map("backup_exclude_tables")
  // Произвольный JSON для маркеров и meta-данных. Пример:
  //   { "migrationId": "<HostpanelMigration.id>", "importedFrom": "vm120", "originalUid": 1002 }
  // Используется hostpanel-миграцией для контракта cleanup'а: cleanup трогает
  // только сайты с metadata.migrationId === currentMigrationId.
  metadata            String? // JSON object
  userId              String   @map("user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  databases       Database[]
  domains         SiteDomain[]
  sslCertificates SslCertificate[]
  deployLogs      DeployLog[]
  backupConfigs   BackupConfig[]
  backups         Backup[]
  cronJobs        CronJob[]
  diskSnapshots   SiteDiskSnapshot[]
  healthPings     HealthCheckPing[]
  dnsZones        DnsZone[]
  services        SiteService[]
  quickCommands   SiteQuickCommand[]
  operations      Operation[]

  @@index([userId])
  @@index([status])
  @@map("sites")
}

/// Быстрая команда сайта (блок «Быстрый доступ» на вкладке «Обзор»).
/// Запускается одним кликом от имени системного пользователя сайта.
/// Это НЕ PM2-процесс — one-shot команда (build/deploy/lint и т.п.).
model SiteQuickCommand {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  /// Человекочитаемая подпись кнопки.
  label     String
  /// Источник: 'npm' (npm run <target>) или 'make' (make <target>).
  source    String
  /// Имя npm-скрипта или make-таргета.
  target    String
  /// Абсолютная рабочая директория (директория Makefile/package.json).
  cwd       String
  /// Порядок отображения в блоке.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_quick_commands")
}

// =============================================================================
// Основной домен сайта и единственная граница приложения. Каждый SiteDomain
// владеет ровно одним preset/runtime; aliases принадлежат этому же приложению.
// Хомдира Linux-пользователя остаётся общей на Site, но filesRelPath всегда
// materialized и относителен к Site.rootPath.
// =============================================================================
model SiteDomain {
  id                         String   @id @default(uuid())
  siteId                     String   @map("site_id")
  /// Доменное имя. Глобально уникально среди всех основных доменов.
  domain                     String   @unique
  /// Главный домен сайта (ровно один на сайт). position=0, корона в UI.
  isPrimary                  Boolean  @default(false) @map("is_primary")
  /// Порядок в списке доменов сайта (главный — 0).
  position                   Int      @default(0)
  /// Алиасы этого домена. JSON: [{ "domain": string, "redirect": boolean }].
  /// redirect=true → 301 на этот основной домен; false → отдаёт тот же сайт.
  aliases                    String   @default("[]")
  /// web-root этого домена ОТНОСИТЕЛЬНО Site.rootPath. Всегда explicit.
  filesRelPath               String   @map("files_rel_path")
  /// MODX_REVO | MODX_3 | CUSTOM (SiteType; validated in runtime for SQLite).
  preset                     String // SiteType
  /// PROVISIONING | RUNNING | DEPLOYING | UPDATING | ERROR.
  appStatus                  String   @default("PROVISIONING") @map("app_status") // DomainApplicationStatus
  appErrorMessage            String?  @map("app_error_message")
  phpVersion                 String?  @map("php_version")
  phpPoolCustom              String?  @map("php_pool_custom")
  /// Immutable global key for PHP pool/socket/log and operation artifacts.
  runtimeKey                 String   @unique @map("runtime_key")
  gitRepository              String?  @map("git_repository")
  deployBranch               String?  @map("deploy_branch")
  envVars                    String   @default("{}") @map("env_vars") // JSON object
  cmsAdminUser               String?  @map("cms_admin_user")
  /// AES-256-GCM, HKDF(master,'meowbox:cms:v1').
  cmsAdminPasswordEnc        String?  @map("cms_admin_password_enc")
  managerPath                String?  @map("manager_path")
  connectorsPath             String?  @map("connectors_path")
  cmsTablePrefix             String?  @map("cms_table_prefix")
  modxVersion                String?  @map("modx_version")
  /// Порт приложения для reverse-proxy (Node и т.п.). null — нет proxy.
  appPort                    Int?     @map("app_port")
  /// 301 HTTP→HTTPS для этого домена (действует при активном SSL).
  httpsRedirect              Boolean  @default(true) @map("https_redirect")
  // --- Layered nginx settings (per-domain). null/0 → дефолты shared/nginx-defaults.ts ---
  nginxClientMaxBodySize     String?  @map("nginx_client_max_body_size")
  nginxFastcgiReadTimeout    Int?     @map("nginx_fastcgi_read_timeout")
  nginxFastcgiSendTimeout    Int?     @map("nginx_fastcgi_send_timeout")
  nginxFastcgiConnectTimeout Int?     @map("nginx_fastcgi_connect_timeout")
  nginxFastcgiBufferSizeKb   Int?     @map("nginx_fastcgi_buffer_size_kb")
  nginxFastcgiBufferCount    Int?     @map("nginx_fastcgi_buffer_count")
  nginxHttp2                 Boolean  @default(true) @map("nginx_http2")
  nginxHsts                  Boolean  @default(false) @map("nginx_hsts")
  nginxGzip                  Boolean  @default(true) @map("nginx_gzip")
  nginxRateLimitEnabled      Boolean  @default(true) @map("nginx_rate_limit_enabled")
  nginxRateLimitRps          Int?     @map("nginx_rate_limit_rps")
  nginxRateLimitBurst        Int?     @map("nginx_rate_limit_burst")
  /// Содержимое 95-custom.conf этого домена (инклюдится в его server-блок).
  nginxCustomConfig          String?  @map("nginx_custom_config")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  site           Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sslCertificate SslCertificate?
  databases      Database[]
  deployLogs     DeployLog[]
  healthPings    HealthCheckPing[]
  auditLogs      AuditLog[]
  operations     Operation[]
  hostnameClaims HostnameClaim[]

  @@unique([siteId, position])
  @@index([siteId, appStatus])
  @@index([preset])
  @@map("site_domains")
}

/// Normalized global registry for canonical domains and aliases.
/// The hostname primary key makes reservation atomic across all Sites.
model HostnameClaim {
  hostname     String   @id
  siteDomainId String   @map("site_domain_id")
  kind         String // CANONICAL | ALIAS
  createdAt    DateTime @default(now()) @map("created_at")

  siteDomain SiteDomain @relation(fields: [siteDomainId], references: [id], onDelete: Cascade)

  @@index([siteDomainId])
  @@map("hostname_claims")
}

// =============================================================================
// Сервисы (Manticore Search и др.) — внешние демоны, которыми сайты могут
// пользоваться. Двухуровневая модель:
//   - ServerService — установлен ли сервис на сервере (apt-пакет, systemd unit-template).
//   - SiteService   — активирован ли сервис для конкретного сайта (per-site instance).
// Per-site инстансы изолированы: свой data_dir, свой socket в /var/www/{site}/tmp/,
// systemd template `{service}@{siteName}.service`.
// =============================================================================

/// Серверный уровень сервиса: версия, статус установки на хост.
/// Один сервис = одна запись (`serviceKey` UNIQUE).
model ServerService {
  id          String    @id @default(uuid())
  serviceKey  String    @unique @map("service_key") // 'manticore', 'redis', ...
  installed   Boolean   @default(false)
  version     String?
  installedAt DateTime? @map("installed_at")
  lastError   String?   @map("last_error")
  config      String    @default("{}") // JSON, серверный конфиг сервиса
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("server_services")
}

/// Активация сервиса для конкретного сайта.
/// `status`: STOPPED — активирован но демон выключен; RUNNING — активен;
/// ERROR — последняя операция упала; STARTING — переходное состояние.
/// `config` хранит per-site overrides (например, memoryMaxMb) — пусто = дефолт.
model SiteService {
  id          String   @id @default(uuid())
  siteId      String   @map("site_id")
  serviceKey  String   @map("service_key")
  status      String   @default("STOPPED") // STARTING | RUNNING | STOPPED | ERROR
  config      String   @default("{}") // JSON: per-site overrides
  lastError   String?  @map("last_error")
  installedAt DateTime @default(now()) @map("installed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, serviceKey])
  @@index([siteId])
  @@index([serviceKey])
  @@map("site_services")
}

model Database {
  id             String   @id @default(uuid())
  // Имя БД уникально в рамках одного движка (type), но может повторяться между
  // движками: на сервере MariaDB и PostgreSQL — это разные namespace, и нельзя
  // блокировать создание pg-БД только потому, что MariaDB уже занял такое имя.
  name           String
  type           String // DatabaseType
  dbUser         String   @map("db_user")
  dbPasswordHash String   @map("db_password_hash")
  // Симметрично-зашифрованный плейн-пароль (AES-256-GCM, base64).
  // Нужен, чтобы открывать БД во встроенном Adminer без ресета. Argon2-хэш —
  // односторонний, поэтому хранить плейн отдельно неизбежно. Шифровка через
  // тот же master-key, что и DNS-credentials (`credentials-cipher.ts`).
  // NULL для legacy-записей, созданных до этой колонки — у них Adminer
  // потребует ресет пароля.
  dbPasswordEnc  String?  @map("db_password_enc")
  // Keep Site ownership for aggregate queries/deletion checks. It must match
  // siteDomain.siteId; service transactions validate this cross-relation.
  siteId         String   @map("site_id")
  siteDomainId   String   @map("site_domain_id")
  purpose        String // DatabasePurpose: APP_PRIMARY | AUXILIARY
  sizeBytes      BigInt   @default(0) @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteDomain SiteDomain  @relation(fields: [siteDomainId], references: [id], onDelete: Restrict)
  operations Operation[]

  @@unique([name, type])
  @@index([siteId])
  @@index([siteDomainId, purpose])
  @@map("databases")
}

// Именованное хранилище для бэкапов. Переиспользуется разными сайтами и
// обоими движками (TAR / RESTIC). `config` — JSON с настройками доступа
// (accessKey/bucket/endpoint/oauthToken/username/password и т.п., зависит
// от `type`). `resticPassword` — пароль репы Restic на этом хранилище;
// генерируется при создании, показывается юзеру один раз.
model StorageLocation {
  id             String   @id @default(uuid())
  name           String   @unique
  type           String // BackupStorageType: LOCAL | S3 | YANDEX_DISK | CLOUD_MAIL_RU
  config         String   @default("{}") // JSON object (креды + опции)
  resticPassword String?  @map("restic_password")
  // Поддерживает ли это хранилище Restic-движок (LOCAL и S3 — да; Y.Disk/Mail.ru — нет)
  resticEnabled  Boolean  @default(false) @map("restic_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  backups                 Backup[]
  backupConfigs           BackupConfig[]
  resticChecks            ResticCheck[]
  serverPathBackupConfigs ServerPathBackupConfig[] @relation("ServerPathBackupConfigToStorageLocation")
  serverPathBackups       ServerPathBackup[]       @relation("ServerPathBackupToStorageLocation")
  panelDataBackupConfigs  PanelDataBackupConfig[]  @relation("PanelDataBackupConfigToStorageLocation")
  panelDataBackups        PanelDataBackup[]        @relation("PanelDataBackupToStorageLocation")
  siteBackupSchedules     SiteBackupSchedule[]     @relation("SiteBackupScheduleToStorageLocation")

  @@map("storage_locations")
}

// История запусков `restic check` — проверка целостности Restic-репозитория.
// Репа = (siteName, storageLocation) — поэтому одна пара хранит свою историю.
// Пишется при ручном запуске из UI и при плановом запуске (scheduler).
model ResticCheck {
  id                String    @id @default(uuid())
  storageLocationId String    @map("storage_location_id")
  // Денормализованное имя сайта (репа именуется по нему).
  // Не FK на Site, чтобы история выжила, если сайт удалят.
  siteName          String    @map("site_name")
  siteId            String?   @map("site_id") // опциональная связь для быстрого join'а
  success           Boolean   @default(false)
  errorMessage      String?   @map("error_message")
  output            String? // stdout restic'а, первые ~4KB
  readData          Boolean   @default(false) @map("read_data")
  readDataSubset    String?   @map("read_data_subset")
  durationMs        Int?      @map("duration_ms")
  // Причина запуска: manual | scheduled
  source            String    @default("manual")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")

  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@index([storageLocationId, siteName])
  @@index([startedAt])
  @@map("restic_checks")
}

model BackupConfig {
  id                 String   @id @default(uuid())
  siteId             String   @map("site_id")
  type               String // BackupType
  // Движок: TAR (старый) / RESTIC (новый, по умолчанию для новых конфигов)
  engine             String   @default("TAR") // BackupEngine
  // Новая схема: список StorageLocation.id (JSON-массив). При автобэкапе
  // архив отправляется в каждое из хранилищ. Для ручного бэкапа выбирается одно.
  storageLocationIds String   @default("[]") @map("storage_location_ids") // JSON string[]
  // Legacy: storageType/storageConfig оставлены nullable для обратной совместимости
  // со старыми записями (мигрируются в StorageLocation при первом редактировании).
  storageType        String?  @map("storage_type") // BackupStorageType
  storageConfig      String?  @map("storage_config") // JSON object
  schedule           String?
  retention          Int      @default(7) // TAR: кол-во бэкапов. Для Restic используются keep*
  // Retention для Restic (`restic forget --keep-*`)
  keepDaily          Int      @default(7) @map("keep_daily")
  keepWeekly         Int      @default(4) @map("keep_weekly")
  keepMonthly        Int      @default(6) @map("keep_monthly")
  keepYearly         Int      @default(1) @map("keep_yearly")
  excludePaths       String   @default("[]") @map("exclude_paths") // JSON string[]
  excludeTableData   String   @default("[]") @map("exclude_table_data") // JSON string[]
  keepLocalCopy      Boolean  @default(false) @map("keep_local_copy")
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  site             Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  backups          Backup[]
  storageLocations StorageLocation[]

  @@index([siteId])
  @@map("backup_configs")
}

// =============================================================================
// Server-path backups: бэкап произвольных директорий сервера (/etc, /opt, /root).
// Один путь = один config. См. docs/specs/2026-05-10-unified-backups.md.
// =============================================================================
model ServerPathBackupConfig {
  id                  String   @id @default(uuid())
  /// Имя конфига для UI и логов: "etc daily", "opt weekly", ...
  name                String
  /// Абсолютный путь. Один путь на конфиг — если нужны разные расписания,
  /// создаёшь второй config с тем же path.
  path                String
  /// Подтверждение, что юзер прочитал warning'и о пути из warnlist
  /// (`/var/log`, `/var/lib/mysql`, ...). Для аудита.
  warningAcknowledged Boolean  @default(false) @map("warning_acknowledged")
  /// Движок: TAR (классический tar.gz) | RESTIC (дедупликация).
  engine              String   @default("RESTIC")
  /// Список StorageLocation.id (JSON-массив).
  storageLocationIds  String   @default("[]") @map("storage_location_ids")
  schedule            String? // cron expression
  retention           Int      @default(7)
  keepDaily           Int      @default(7) @map("keep_daily")
  keepWeekly          Int      @default(4) @map("keep_weekly")
  keepMonthly         Int      @default(6) @map("keep_monthly")
  keepYearly          Int      @default(1) @map("keep_yearly")
  /// Restic-exclude паттерны (относительно path).
  excludePaths        String   @default("[]") @map("exclude_paths")
  enabled             Boolean  @default(true)
  /// Режим уведомлений: INSTANT (по каждому), DIGEST (накапливать и слать по
  /// cron), FAILURES_ONLY (только при ошибке). См. NotificationDigestQueue.
  notificationMode    String   @default("INSTANT") @map("notification_mode")
  /// cron для отправки дайджеста (используется только при notificationMode=DIGEST).
  digestSchedule      String?  @map("digest_schedule")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  backups          ServerPathBackup[]
  storageLocations StorageLocation[]  @relation("ServerPathBackupConfigToStorageLocation")

  @@index([enabled])
  @@map("server_path_backup_configs")
}

model ServerPathBackup {
  id                String    @id @default(uuid())
  configId          String    @map("config_id")
  status            String    @default("PENDING") // BackupStatus
  engine            String    @default("RESTIC")
  storageLocationId String?   @map("storage_location_id")
  resticSnapshotId  String?   @map("restic_snapshot_id")
  filePath          String    @default("") @map("file_path")
  sizeBytes         BigInt?   @map("size_bytes")
  progress          Int       @default(0)
  errorMessage      String?   @map("error_message")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  config          ServerPathBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation?       @relation("ServerPathBackupToStorageLocation", fields: [storageLocationId], references: [id], onDelete: SetNull)

  @@index([configId])
  @@index([status])
  @@map("server_path_backups")
}

// =============================================================================
// Panel-data backups: жёстко зашитый набор путей для бэкапа данных самой панели.
// Путей юзер не выбирает — preset защищает от ошибки "забыл .master-key".
// =============================================================================
model PanelDataBackupConfig {
  id                 String   @id @default(uuid())
  name               String
  engine             String   @default("RESTIC")
  storageLocationIds String   @default("[]") @map("storage_location_ids")
  schedule           String?
  retention          Int      @default(7)
  keepDaily          Int      @default(24) @map("keep_daily") // 24 hourly = day
  keepWeekly         Int      @default(7) @map("keep_weekly") // 7 days
  keepMonthly        Int      @default(12) @map("keep_monthly")
  keepYearly         Int      @default(5) @map("keep_yearly")
  enabled            Boolean  @default(true)
  /// Режим уведомлений (см. ServerPathBackupConfig.notificationMode).
  notificationMode   String   @default("INSTANT") @map("notification_mode")
  digestSchedule     String?  @map("digest_schedule")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  backups          PanelDataBackup[]
  storageLocations StorageLocation[] @relation("PanelDataBackupConfigToStorageLocation")

  @@index([enabled])
  @@map("panel_data_backup_configs")
}

model PanelDataBackup {
  id                String    @id @default(uuid())
  configId          String    @map("config_id")
  status            String    @default("PENDING")
  engine            String    @default("RESTIC")
  storageLocationId String?   @map("storage_location_id")
  resticSnapshotId  String?   @map("restic_snapshot_id")
  filePath          String    @default("") @map("file_path")
  sizeBytes         BigInt?   @map("size_bytes")
  progress          Int       @default(0)
  errorMessage      String?   @map("error_message")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  config          PanelDataBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation?      @relation("PanelDataBackupToStorageLocation", fields: [storageLocationId], references: [id], onDelete: SetNull)

  @@index([configId])
  @@index([status])
  @@map("panel_data_backups")
}

// =============================================================================
// SiteBackupSchedule — глобальные шедули per-site бэкапов (множественные).
// Заменяет одиночные `PanelSetting('backup-defaults')`: теперь можно иметь
// несколько шедулей с разными хранилищами/расписаниями/типами, и они
// применяются ко ВСЕМ сайтам, у которых нет per-site BackupConfig.
// Логика старого `backup-defaults` (одна форма на всю панель) переехала сюда.
// =============================================================================
model SiteBackupSchedule {
  id                    String   @id @default(uuid())
  /// Имя для UI: "hourly DB to local", "daily FULL to S3", ...
  name                  String
  enabled               Boolean  @default(true)
  /// BackupType (FULL | FILES_ONLY | DB_ONLY | DIFFERENTIAL)
  type                  String   @default("FULL")
  /// BackupEngine (TAR | RESTIC)
  engine                String   @default("RESTIC")
  /// JSON string[] — StorageLocation.id
  storageLocationIds    String   @default("[]") @map("storage_location_ids")
  /// cron-расписание основного запуска
  schedule              String?
  /// Для RESTIC — keep-политика
  keepDaily             Int      @default(7) @map("keep_daily")
  keepWeekly            Int      @default(4) @map("keep_weekly")
  keepMonthly           Int      @default(6) @map("keep_monthly")
  keepYearly            Int      @default(1) @map("keep_yearly")
  /// Для TAR — кол-во последних бэкапов
  retentionDays         Int      @default(7) @map("retention_days")
  /// JSON string[]
  excludePaths          String   @default("[]") @map("exclude_paths")
  excludeTableData      String   @default("[]") @map("exclude_table_data")
  /// Restic integrity check
  checkEnabled          Boolean  @default(false) @map("check_enabled")
  checkSchedule         String?  @map("check_schedule")
  checkReadData         Boolean  @default(false) @map("check_read_data")
  checkReadDataSubset   String?  @map("check_read_data_subset")
  checkMinIntervalHours Int      @default(168) @map("check_min_interval_hours")
  /// Режим уведомлений: INSTANT | DIGEST | FAILURES_ONLY
  notificationMode      String   @default("INSTANT") @map("notification_mode")
  digestSchedule        String?  @map("digest_schedule")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  storageLocations StorageLocation[] @relation("SiteBackupScheduleToStorageLocation")
  backups          Backup[]

  @@index([enabled])
  @@map("site_backup_schedules")
}

// =============================================================================
// NotificationDigestQueue — очередь событий для дайджест-уведомлений.
// Когда у бэкап-конфига notificationMode=DIGEST, completeBackup() пишет
// сюда вместо прямого dispatch. Отдельный cron `flushDigests` забирает
// записи с `sentAt IS NULL` сгруппированно по configType+configId,
// отправляет одним сообщением и проставляет sentAt.
//
// configName/resourceLabel — снапшоты, чтобы дайджест выглядел нормально
// даже если конфиг был удалён до отправки.
// =============================================================================
model NotificationDigestQueue {
  id            String    @id @default(uuid())
  /// SITE_SCHEDULE | SERVER_PATH | PANEL_DATA — какой тип бэкапа
  configType    String    @map("config_type")
  /// id шедуля/конфига (FK не ставим — нужно сохранить запись при удалении конфига)
  configId      String    @map("config_id")
  /// Имя конфига на момент события (для красивого заголовка)
  configName    String    @map("config_name")
  /// BACKUP_COMPLETED | BACKUP_FAILED
  event         String
  /// Имя ресурса (site name / path / "Panel Data") — для строки в дайджесте
  resourceLabel String    @map("resource_label")
  sizeBytes     BigInt?   @map("size_bytes")
  /// errorMessage или дополнительная инфа
  message       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")

  @@index([configType, configId, sentAt])
  @@index([sentAt])
  @@map("notification_digest_queue")
}

model Backup {
  id                String    @id @default(uuid())
  siteId            String    @map("site_id")
  configId          String?   @map("config_id")
  /// SiteBackupSchedule, по которому запущен этот бэкап (если запуск был из шедуля).
  /// Используется для группировки уведомлений в дайджест: один cron-запуск шедуля
  /// собирает в очередь все per-site события и шлёт одной пачкой.
  scheduleId        String?   @map("schedule_id")
  type              String // BackupType
  status            String    @default("PENDING") // BackupStatus
  // Движок, которым сделан этот бэкап
  engine            String    @default("TAR") // BackupEngine
  // Для новых записей: привязка к StorageLocation (id)
  storageLocationId String?   @map("storage_location_id")
  // Для Restic: id снапшота в репе. Null для TAR.
  resticSnapshotId  String?   @map("restic_snapshot_id")
  // Legacy: для TAR это путь к архиву. Для Restic не используется.
  storageType       String?   @map("storage_type") // BackupStorageType (legacy, nullable)
  filePath          String    @default("") @map("file_path")
  sizeBytes         BigInt?   @map("size_bytes")
  progress          Int       @default(0)
  errorMessage      String?   @map("error_message")
  // Versioned domain/application mapping captured with the backup. Contains
  // encrypted credentials only; never expose through public backup responses.
  manifest          String?
  // Durable in-flight restore state (operation id, nonce and phase). Cleared
  // after restore finalization so stale agent events cannot complete a retry.
  restoreContext    String?   @map("restore_context")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  baseBackupId      String?   @map("base_backup_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  site            Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  config          BackupConfig?       @relation(fields: [configId], references: [id], onDelete: SetNull)
  schedule        SiteBackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  storageLocation StorageLocation?    @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  baseBackup      Backup?             @relation("DiffBase", fields: [baseBackupId], references: [id], onDelete: SetNull)
  differentials   Backup[]            @relation("DiffBase")
  exports         BackupExport[]

  @@index([siteId])
  @@index([status])
  @@index([scheduleId])
  @@map("backups")
}

// Экспорт бэкапа в виде скачиваемого архива.
// Два режима:
//   STREAM        — API спавнит restic dump --archive tar и стримит stdout прямо
//                   в HTTP response. Без диска, без сокетов. Single-host only.
//   S3_PRESIGNED  — агент делает restic dump → загружает tar в тот же bucket
//                   под exports/<id>.tar → API возвращает pre-signed URL.
//                   Подходит для S3-хранилищ; trafic качается напрямую из S3.
// expiresAt — время истечения. Cron каждый час смотрит истекшие, удаляет
// S3-объект и помечает запись EXPIRED. Для STREAM — просто чистится запись.
model BackupExport {
  id              String   @id @default(uuid())
  backupId        String   @map("backup_id")
  mode            String   @default("STREAM") // BackupExportMode: STREAM | STAGED_ARTIFACT | S3_PRESIGNED
  status          String   @default("PENDING") // BackupExportStatus: PENDING | PROCESSING | READY | FAILED | EXPIRED
  // Для S3_PRESIGNED: ключ объекта в bucket (`exports/<uuid>.tar`).
  s3Key           String?  @map("s3_key")
  // URL для скачивания: либо API-роут (STREAM), либо pre-signed URL (S3).
  downloadUrl     String?  @map("download_url")
  // Когда истекает экспорт. Cron-cleaner смотрит на это поле.
  expiresAt       DateTime @map("expires_at")
  sizeBytes       BigInt?  @map("size_bytes")
  errorMessage    String?  @map("error_message")
  // Durable preparation state for STAGED_ARTIFACT exports. Both links are
  // nullable so old releases ignore additive federation/transfer state.
  operationId     String?  @unique @map("operation_id")
  artifactId      String?  @unique @map("artifact_id")
  // Юзер, инициировавший экспорт (для аудита и проверки прав на скачивание).
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  backup        Backup            @relation(fields: [backupId], references: [id], onDelete: Cascade)
  createdByUser User              @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@index([status])
  @@index([expiresAt])
  @@index([mode, status, createdAt])
  @@map("backup_exports")
}

model SslCertificate {
  id            String    @id @default(uuid())
  // Денормализованная ссылка на сайт (для каскада и быстрых выборок). НЕ unique:
  // у сайта теперь несколько сертификатов — по одному на основной домен.
  siteId        String    @map("site_id")
  // Основной домен, которому принадлежит сертификат (1:1). nullable — backfill
  // системной миграцией для legacy-записей; новые записи всегда с domainId.
  domainId      String?   @unique @map("domain_id")
  domains       String    @default("[]") // JSON string[]
  status        String    @default("NONE") // SslStatus
  issuer        String    @default("")
  isWildcard    Boolean   @default(false) @map("is_wildcard")
  issuedAt      DateTime? @map("issued_at")
  expiresAt     DateTime? @map("expires_at")
  daysRemaining Int?      @map("days_remaining")
  certPath      String?   @map("cert_path")
  keyPath       String?   @map("key_path")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  site   Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  domain SiteDomain? @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("ssl_certificates")
}

model DeployLog {
  id            String    @id @default(uuid())
  siteId        String    @map("site_id")
  siteDomainId  String    @map("site_domain_id")
  operationId   String?   @unique @map("operation_id")
  status        String    @default("PENDING") // DeployStatus
  commitSha     String?   @map("commit_sha")
  commitMessage String?   @map("commit_message")
  branch        String
  output        String    @default("")
  triggeredBy   String?   @map("triggered_by")
  durationMs    Int?      @map("duration_ms")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteDomain SiteDomain @relation(fields: [siteDomainId], references: [id], onDelete: Cascade)
  operation  Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([siteDomainId, createdAt])
  @@index([status])
  @@map("deploy_logs")
}

model CronJob {
  id           String    @id @default(uuid())
  siteId       String    @map("site_id")
  name         String
  schedule     String
  command      String
  status       String    @default("ACTIVE") // CronJobStatus
  lastOutput   String?   @map("last_output")
  lastRunAt    DateTime? @map("last_run_at")
  lastExitCode Int?      @map("last_exit_code")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("cron_jobs")
}

model NotificationSetting {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  channel   String // NotificationChannel
  events    String   @default("[]") // JSON string[]
  enabled   Boolean  @default(true)
  config    String   @default("{}") // JSON object
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_settings")
}

model FirewallRule {
  id        String   @id @default(uuid())
  action    String // FirewallRuleAction
  protocol  String // FirewallProtocol
  port      String?
  sourceIp  String?  @map("source_ip")
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("firewall_rules")
}

// Server-level блокировка трафика по странам (на основе ipset+iptables).
// База CIDR-блоков обновляется по расписанию (см. PanelSetting `country-block`).
// Страна — ISO 3166-1 alpha-2 (uppercase): RU, CN, US...
// ports: null/'' = блокировка всех портов; иначе CSV портов или диапазон 8000:9000.
// protocol: TCP|UDP|BOTH (для null ports игнорируется — блокируется ВСЁ).
// Удаление записи → агент чистит ipset/iptables правило для этой страны.
model CountryBlock {
  id        String   @id @default(uuid())
  country   String // ISO 3166-1 alpha-2 (RU, CN, US...)
  ports     String?
  protocol  String   @default("BOTH") // TCP|UDP|BOTH
  enabled   Boolean  @default(true)
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([country, ports, protocol], name: "country_ports_protocol")
  @@map("country_blocks")
}

model SiteDiskSnapshot {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  wwwBytes  BigInt   @default(0) @map("www_bytes")
  logsBytes BigInt   @default(0) @map("logs_bytes")
  tmpBytes  BigInt   @default(0) @map("tmp_bytes")
  dbBytes   BigInt   @default(0) @map("db_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@map("site_disk_snapshots")
}

model MetricsSnapshot {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  cpuPercent    Float    @map("cpu_percent")
  memoryPercent Float    @map("memory_percent")
  memoryUsed    BigInt   @map("memory_used")
  memoryTotal   BigInt   @map("memory_total")
  diskPercent   Float    @map("disk_percent")
  diskUsed      BigInt   @map("disk_used")
  diskTotal     BigInt   @map("disk_total")
  networkRx     BigInt   @map("network_rx")
  networkTx     BigInt   @map("network_tx")

  @@index([timestamp])
  @@map("metrics_snapshots")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  siteDomainId String?  @map("site_domain_id")
  operationId  String?  @map("operation_id")
  action       String // AuditAction
  entity       String
  entityId     String?  @map("entity_id")
  details      String? // JSON object
  ipAddress    String   @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteDomain SiteDomain? @relation(fields: [siteDomainId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([siteDomainId, createdAt])
  @@index([operationId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Durable state for site/domain mutations. Idempotency keys are global UUIDs;
/// OperationLock.resourceKey enforces one active lock for every acquired scope.
model Operation {
  id                String    @id @default(uuid())
  idempotencyKey    String    @unique @map("idempotency_key")
  requestHash       String    @map("request_hash")
  type              String
  status            String    @default("PENDING") // OperationStatus
  siteId            String?   @map("site_id")
  siteDomainId      String?   @map("site_domain_id")
  databaseId        String?   @map("database_id")
  globalLockKey     String?   @map("global_lock_key")
  parentOperationId String?   @map("parent_operation_id")
  createdByUserId   String    @map("created_by_user_id")
  currentStep       String?   @map("current_step")
  progress          Int       @default(0)
  actionId          String?   @map("action_id")
  executionMode     String    @default("INLINE") @map("execution_mode")
  policySnapshot    String?   @map("policy_snapshot")
  requestPayloadEnc String?   @map("request_payload_enc")
  attempt           Int       @default(0)
  maxAttempts       Int       @default(1) @map("max_attempts")
  retryable         Boolean   @default(false)
  recoveryPolicy    String    @default("MANUAL") @map("recovery_policy")
  leaseOwner        String?   @map("lease_owner")
  leaseExpiresAt    DateTime? @map("lease_expires_at")
  heartbeatAt       DateTime? @map("heartbeat_at")
  claimedAt         DateTime? @map("claimed_at")
  deadlineAt        DateTime? @map("deadline_at")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  cancelOutcome     String?   @map("cancel_outcome")
  result            String? // JSON object, secrets forbidden
  errorMessage      String?   @map("error_message")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  site            Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteDomain      SiteDomain?     @relation(fields: [siteDomainId], references: [id], onDelete: SetNull)
  database        Database?       @relation(fields: [databaseId], references: [id], onDelete: SetNull)
  createdByUser   User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  parentOperation Operation?      @relation("OperationHierarchy", fields: [parentOperationId], references: [id], onDelete: Cascade)
  childOperations Operation[]     @relation("OperationHierarchy")
  locks           OperationLock[]
  agentJobs       AgentJob[]
  deployLog       DeployLog?

  @@index([siteId, status])
  @@index([siteDomainId, status])
  @@index([databaseId, status])
  @@index([globalLockKey, status])
  @@index([parentOperationId, createdAt])
  @@index([executionMode, status, leaseExpiresAt, createdAt])
  @@index([createdByUserId, status, createdAt])
  @@index([actionId, status])
  @@index([createdAt])
  @@map("operations")
}

/// Durable identity and result ledger for one operation step executed by the
/// local agent. The deterministic ID prevents duplicate effects after API or
/// Socket.IO reconnects.
model AgentJob {
  id                String    @id
  operationId       String    @map("operation_id")
  step              String
  actionId          String    @map("action_id")
  protocolVersion   Int       @default(1) @map("protocol_version")
  state             String    @default("STARTING")
  requestHash       String    @map("request_hash")
  agentBootId       String?   @map("agent_boot_id")
  sequence          Int       @default(0)
  progress          Int       @default(0)
  currentStep       String?   @map("current_step")
  cancelSafe        Boolean   @default(false) @map("cancel_safe")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  cancelOutcome     String?   @map("cancel_outcome")
  result            String?
  errorMessage      String?   @map("error_message")
  startedAt         DateTime? @map("started_at")
  heartbeatAt       DateTime? @map("heartbeat_at")
  completedAt       DateTime? @map("completed_at")
  deadlineAt        DateTime  @map("deadline_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, step])
  @@index([operationId, state])
  @@index([agentBootId, state])
  @@index([state, heartbeatAt])
  @@index([deadlineAt])
  @@map("agent_jobs")
}

/// Master-side pointer to the canonical target Operation. It contains no
/// duplicated execution state or target payload.
model RemoteOperationLink {
  id                String    @id @default(uuid())
  remoteServerId    String    @map("remote_server_id")
  targetOperationId String    @map("target_operation_id")
  masterUserId      String    @map("master_user_id")
  actionId          String    @map("action_id")
  requestId         String    @map("request_id")
  correlationId     String    @map("correlation_id")
  lastPolledAt      DateTime? @map("last_polled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  remoteServer RemoteServer @relation(fields: [remoteServerId], references: [id], onDelete: Restrict)
  masterUser   User         @relation(fields: [masterUserId], references: [id], onDelete: Restrict)

  @@unique([remoteServerId, targetOperationId])
  @@unique([remoteServerId, requestId])
  @@index([masterUserId, createdAt])
  @@index([correlationId])
  @@map("remote_operation_links")
}

/// Accumulating resource locks for operations that touch several Sites/domains.
/// Rows are removed only when their owner reaches a terminal status.
model OperationLock {
  resourceKey String   @id @map("resource_key")
  operationId String   @map("operation_id")
  kind        String
  createdAt   DateTime @default(now()) @map("created_at")

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@map("operation_locks")
}

// Audit-лог проксирующих запросов: master→slave (direction=OUT) и
// slave-сторона (direction=IN, прилетевший от чужой панели запрос).
// Отдельная таблица потому что:
//   - userId опциональный (на slave userId=null, действует proxy-bot)
//   - serverId/serverName — snapshot, чтобы при удалении сервера лог не терялся
//   - быстрый отбор по серверу (в /servers покажем history последних действий)
model ProxyAuditLog {
  id                   String   @id @default(uuid())
  direction            String // "OUT" | "IN"
  userId               String?  @map("user_id") // master-side: кто инициировал; slave-side: null
  serverId             String?  @map("server_id") // master-side: цель; slave-side: null
  serverName           String?  @map("server_name") // snapshot имени на момент действия
  method               String // HTTP метод (GET/POST/...)
  path                 String // path без префикса /api (e.g. "/sites/123")
  statusCode           Int?     @map("status_code") // HTTP-код ответа slave (или null если запрос упал на сети)
  durationMs           Int      @default(0) @map("duration_ms")
  ipAddress            String   @map("ip_address") // IP клиента (master-side) / IP master (slave-side)
  userAgent            String?  @map("user_agent")
  errorMsg             String?  @map("error_msg") // сообщение об ошибке если запрос упал
  requestId            String?  @map("request_id")
  actionId             String?  @map("action_id")
  issuerInstallationId String?  @map("issuer_installation_id")
  targetInstallationId String?  @map("target_installation_id")
  targetPrincipalId    String?  @map("target_principal_id")
  actorKind            String?  @map("actor_kind")
  keyId                String?  @map("key_id")
  operationId          String?  @map("operation_id")
  peerIp               String?  @map("peer_ip")
  browserIp            String?  @map("browser_ip")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([direction])
  @@index([serverId])
  @@index([userId])
  @@index([createdAt])
  @@index([requestId, direction])
  @@index([actionId, createdAt])
  @@map("proxy_audit_logs")
}

// =============================================================================
// Remote-panel federation control plane
// =============================================================================

/// Stable local installation identity. The singleton row uses id = "_".
model PanelIdentity {
  id                    String   @id @default("_")
  installationId        String   @unique @map("installation_id")
  installationRole      String   @default("MASTER") @map("installation_role")
  manifestKid           String?  @map("manifest_kid")
  manifestPublicKeySpki String?  @map("manifest_public_key_spki")
  manifestPrivateKeyEnc String?  @map("manifest_private_key_enc")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("panel_identities")
}

/// One-use, target-origin Adminer/Manticore launch. Credentials remain
/// encrypted; the browser receives only the row ID and a 256-bit secret whose
/// SHA-256 digest is stored here.
model AdminerHandoff {
  id                   String    @id @default(uuid())
  targetInstallationId String    @map("target_installation_id")
  purpose              String
  resourceKind         String    @map("resource_kind")
  resourceId           String    @map("resource_id")
  secretHash           String    @unique @map("secret_hash")
  payloadEnc           String    @map("payload_enc")
  actorKind            String    @map("actor_kind")
  actorSubjectHash     String    @map("actor_subject_hash")
  actorRole            String    @map("actor_role")
  expiresAt            DateTime  @map("expires_at")
  consumedAt           DateTime? @map("consumed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([expiresAt, consumedAt])
  @@index([targetInstallationId, createdAt])
  @@index([actorSubjectHash, createdAt])
  @@map("adminer_handoffs")
}

/// Fixed artifact metadata. The file path is always relative to the managed
/// transfer spool and is exposed only through a validated TransferSession.
model TransferArtifact {
  id                   String    @id @default(uuid())
  targetInstallationId String    @map("target_installation_id")
  sourceKind           String    @map("source_kind")
  resourceId           String    @map("resource_id")
  state                String    @default("STAGING")
  relativePath         String    @map("relative_path")
  contentType          String    @map("content_type")
  filename             String
  sizeBytes            BigInt?   @map("size_bytes")
  sha256               String?
  createdByUserId      String    @map("created_by_user_id")
  expiresAt            DateTime  @map("expires_at")
  readyAt              DateTime? @map("ready_at")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  sessions TransferSession[]

  @@index([state, expiresAt])
  @@index([sourceKind, resourceId, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("transfer_artifacts")
}

/// Short-lived direct delivery lease. The 256-bit browser secret is represented
/// only by secretHash; generated streams are single-start and non-resumable.
model TransferSession {
  id                   String    @id @default(uuid())
  targetInstallationId String    @map("target_installation_id")
  purpose              String
  sourceKind           String    @map("source_kind")
  resourceId           String    @map("resource_id")
  resourcePayloadEnc   String?   @map("resource_payload_enc")
  transferMode         String    @map("transfer_mode")
  secretHash           String    @unique @map("secret_hash")
  actorUserId          String    @map("actor_user_id")
  actorRole            String    @map("actor_role")
  contentType          String    @map("content_type")
  filename             String
  artifactId           String?   @map("artifact_id")
  contentLength        BigInt?   @map("content_length")
  sha256               String?
  expiresAt            DateTime  @map("expires_at")
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")
  consumedAt           DateTime? @map("consumed_at")
  failureCode          String?   @map("failure_code")
  createdAt            DateTime  @default(now()) @map("created_at")

  artifact TransferArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([actorUserId, expiresAt, completedAt])
  @@index([targetInstallationId, expiresAt, completedAt])
  @@index([sourceKind, resourceId, createdAt])
  @@index([artifactId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("transfer_sessions")
}

/// Master-owned registry row. Existing legacy server IDs are preserved.
model RemoteServer {
  id                          String    @id
  installationId              String?   @unique @map("installation_id")
  displayName                 String    @unique @map("display_name")
  registryGeneration          Int       @default(1) @map("registry_generation")
  activationMode              String    @default("DISABLED") @map("activation_mode")
  topologyMode                String    @default("PUBLIC") @map("topology_mode")
  protocolVersion             Int?      @map("protocol_version")
  manifestRevision            String?   @map("manifest_revision")
  targetManifestKid           String?   @map("target_manifest_kid")
  targetManifestPublicKeySpki String?   @map("target_manifest_public_key_spki")
  targetManifestPinnedAt      DateTime? @map("target_manifest_pinned_at")
  productVersion              String?   @map("product_version")
  transportState              String    @default("UNKNOWN") @map("transport_state")
  trustState                  String    @default("UNENROLLED") @map("trust_state")
  capabilityState             String    @default("UNKNOWN") @map("capability_state")
  browserState                String    @default("UNKNOWN") @map("browser_state")
  reasonCode                  String?   @map("reason_code")
  transportReasonCode         String?   @map("transport_reason_code")
  trustReasonCode             String?   @map("trust_reason_code")
  capabilityReasonCode        String?   @map("capability_reason_code")
  browserReasonCode           String?   @map("browser_reason_code")
  statusCheckedAt             DateTime? @map("status_checked_at")
  transportFreshUntil         DateTime? @map("transport_fresh_until")
  trustCheckedAt              DateTime? @map("trust_checked_at")
  trustFreshUntil             DateTime? @map("trust_fresh_until")
  manifestFetchedAt           DateTime? @map("manifest_fetched_at")
  browserCheckedAt            DateTime? @map("browser_checked_at")
  browserFreshUntil           DateTime? @map("browser_fresh_until")
  activeEndpointGeneration    Int?      @map("active_endpoint_generation")
  candidateEndpointGeneration Int?      @map("candidate_endpoint_generation")
  previousEndpointGeneration  Int?      @map("previous_endpoint_generation")
  httpEnabled                 Boolean   @default(false) @map("http_enabled")
  wsEnabled                   Boolean   @default(false) @map("ws_enabled")
  publicEnabled               Boolean   @default(false) @map("public_enabled")
  legacyEnabled               Boolean   @default(false) @map("legacy_enabled")
  rolloutStage                String    @default("DISABLED") @map("rollout_stage")
  rolloutStageStartedAt       DateTime? @map("rollout_stage_started_at")
  rolloutEvidenceJson         String?   @map("rollout_evidence_json")
  rolloutApprovedAt           DateTime? @map("rollout_approved_at")
  legacyUrl                   String?   @map("legacy_url")
  legacyTokenEnc              String?   @map("legacy_token_enc")
  mutationFrozenAt            DateTime? @map("mutation_frozen_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  endpoints      RemoteEndpoint[]
  manifests      RemoteManifestSnapshot[]
  issuers        FederationIssuer[]
  enrollments    FederationEnrollment[]
  cutovers       RemoteEndpointCutover[]
  operationLinks RemoteOperationLink[]
  vpnSubscriptionSources FederatedVpnSubscriptionSource[]
  webhookRoutes WebhookRoute[]

  @@index([activationMode, transportState])
  @@index([trustState, capabilityState])
  @@index([rolloutStage, updatedAt])
  @@index([updatedAt])
  @@map("remote_servers")
}

model RemoteEndpoint {
  id                   String    @id @default(uuid())
  remoteServerId       String    @map("remote_server_id")
  generation           Int
  state                String    @default("CANDIDATE")
  apiOrigin            String    @map("api_origin")
  wsOrigin             String    @map("ws_origin")
  wsPath               String    @default("/socket.io") @map("ws_path")
  browserPublicOrigin  String?   @map("browser_public_origin")
  directTransferOrigin String?   @map("direct_transfer_origin")
  sshHost              String    @map("ssh_host")
  sshPort              Int       @default(22) @map("ssh_port")
  spkiSha256           String    @map("spki_sha256")
  caCertificatePem     String?   @map("ca_certificate_pem")
  normalizedHash       String    @map("normalized_hash")
  verifiedAt           DateTime? @map("verified_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  remoteServer RemoteServer @relation(fields: [remoteServerId], references: [id], onDelete: Cascade)

  @@unique([remoteServerId, generation])
  @@index([remoteServerId, state])
  @@map("remote_endpoints")
}

model RemoteManifestSnapshot {
  id                  String    @id @default(uuid())
  remoteServerId      String    @map("remote_server_id")
  schemaVersion       Int       @map("schema_version")
  revision            String
  catalogueSha256     String?   @map("catalogue_sha256")
  protocolMode        String    @default("disabled") @map("protocol_mode")
  protocolMin         Int       @map("protocol_min")
  protocolMax         Int       @map("protocol_max")
  acceptedMasterRange String    @map("accepted_master_range")
  capabilitiesJson    String    @map("capabilities_json")
  endpointState       String    @default("UNCONFIGURED") @map("endpoint_state")
  endpointsJson       String    @map("endpoints_json")
  signingKid          String    @map("signing_kid")
  signature           String
  validationState     String    @map("validation_state")
  generatedAt         DateTime? @map("generated_at")
  validUntil          DateTime  @map("valid_until")
  fetchedAt           DateTime  @default(now()) @map("fetched_at")

  remoteServer RemoteServer @relation(fields: [remoteServerId], references: [id], onDelete: Cascade)

  @@unique([remoteServerId, revision])
  @@index([remoteServerId, fetchedAt])
  @@index([validUntil])
  @@map("remote_manifest_snapshots")
}

/// Trust policy for one issuer/target relationship. Targets may have no local
/// RemoteServer row, so remoteServerId remains optional.
model FederationIssuer {
  id                   String    @id @default(uuid())
  remoteServerId       String?   @map("remote_server_id")
  issuerInstallationId String    @map("issuer_installation_id")
  targetInstallationId String    @map("target_installation_id")
  state                String    @default("PENDING")
  maxRole              String    @default("MANAGER") @map("max_role")
  permissionPolicyJson String    @default("[]") @map("permission_policy_json")
  principalVersion     Int       @default(1) @map("principal_version")
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  remoteServer        RemoteServer?                  @relation(fields: [remoteServerId], references: [id], onDelete: SetNull)
  keys                FederationKey[]
  replays             FederationReplay[]
  idempotencyReceipts FederationIdempotencyReceipt[]
  federatedPrincipals FederatedPrincipal[]
  servicePrincipals   ServicePrincipal[]

  @@unique([issuerInstallationId, targetInstallationId])
  @@index([remoteServerId, state])
  @@index([state, updatedAt])
  @@map("federation_issuers")
}

/// Human operator shadow identity. Authorization never uses User.role; it is
/// derived from the verified assertion, issuer policy, and action descriptor.
model FederatedPrincipal {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  issuerId         String    @map("issuer_id")
  subject          String
  principalVersion Int       @default(1) @map("principal_version")
  displayLabel     String?   @map("display_label")
  tombstonedAt     DateTime? @map("tombstoned_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user   User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  issuer FederationIssuer @relation(fields: [issuerId], references: [id], onDelete: Restrict)

  @@unique([issuerId, subject])
  @@index([issuerId, tombstonedAt])
  @@index([lastSeenAt])
  @@map("federated_principals")
}

/// Non-human one-purpose actor. It never receives a User row or owns personal
/// target data.
model ServicePrincipal {
  id               String    @id @default(uuid())
  issuerId         String    @map("issuer_id")
  subject          String
  purposeNamespace String    @map("purpose_namespace")
  state            String    @default("ACTIVE")
  principalVersion Int       @default(1) @map("principal_version")
  permissionsJson  String    @default("[]") @map("permissions_json")
  deactivatedAt    DateTime? @map("deactivated_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  issuer FederationIssuer @relation(fields: [issuerId], references: [id], onDelete: Restrict)

  @@unique([issuerId, subject])
  @@index([issuerId, state])
  @@index([purposeNamespace, state])
  @@map("service_principals")
}

model FederationKey {
  id                  String    @id @default(uuid())
  issuerId            String    @map("issuer_id")
  kid                 String    @unique
  publicKeySpki       String    @map("public_key_spki")
  encryptedPrivateKey String?   @map("encrypted_private_key")
  state               String    @default("ACTIVE")
  validFrom           DateTime  @default(now()) @map("valid_from")
  expiresAt           DateTime? @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  issuer FederationIssuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  @@index([issuerId, state])
  @@index([expiresAt])
  @@map("federation_keys")
}

model FederationEnrollment {
  id                    String    @id @default(uuid())
  remoteServerId        String?   @map("remote_server_id")
  enrollmentRole        String    @default("TARGET_BOOTSTRAP") @map("enrollment_role")
  requestedByUserId     String?   @map("requested_by_user_id")
  requestedDisplayName  String    @map("requested_display_name")
  state                 String    @default("PREPARED")
  sshHost               String    @map("ssh_host")
  sshPort               Int       @default(22) @map("ssh_port")
  sshFingerprint        String    @map("ssh_fingerprint")
  bootstrapHash         String    @unique @map("bootstrap_hash")
  bootstrapSecretEnc    String?   @map("bootstrap_secret_enc")
  candidateEndpointJson String?   @map("candidate_endpoint_json")
  targetInstallationId  String?   @map("target_installation_id")
  targetManifestKid     String?   @map("target_manifest_kid")
  targetManifestKeySpki String?   @map("target_manifest_key_spki")
  delegationIssuerId    String?   @map("delegation_issuer_id")
  sanitizedErrorCode    String?   @map("sanitized_error_code")
  attemptCount          Int       @default(0) @map("attempt_count")
  lastAttemptAt         DateTime? @map("last_attempt_at")
  leaseUntil            DateTime? @map("lease_until")
  expiresAt             DateTime  @map("expires_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  remoteServer RemoteServer? @relation(fields: [remoteServerId], references: [id], onDelete: SetNull)

  @@index([state, updatedAt])
  @@index([enrollmentRole, state, updatedAt])
  @@index([remoteServerId])
  @@index([requestedByUserId, createdAt])
  @@index([delegationIssuerId])
  @@index([enrollmentRole, leaseUntil])
  @@index([expiresAt])
  @@map("federation_enrollments")
}

/// Atomic replay tombstone. replayHash is a SHA-256 digest and contains no
/// assertion, nonce, path, or credential material.
model FederationReplay {
  replayHash String   @id @map("replay_hash")
  issuerId   String   @map("issuer_id")
  kid        String
  requestId  String   @map("request_id")
  actionId   String   @map("action_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  issuer FederationIssuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  @@unique([issuerId, requestId])
  @@index([issuerId, expiresAt])
  @@index([expiresAt])
  @@map("federation_replays")
}

/// Hash-only mutation admission record. Protocol 1 blocks both conflicting
/// reuse and blind replay until a later operation/result reconciles the claim.
model FederationIdempotencyReceipt {
  id                 String   @id @default(uuid())
  issuerId           String   @map("issuer_id")
  actorKind          String   @map("actor_kind")
  subjectHash        String   @map("subject_hash")
  actionId           String   @map("action_id")
  idempotencyKeyHash String   @map("idempotency_key_hash")
  requestHash        String   @map("request_hash")
  requestId          String   @map("request_id")
  state              String   @default("CLAIMED")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  issuer FederationIssuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  @@unique([issuerId, actorKind, subjectHash, actionId, idempotencyKeyHash])
  @@index([issuerId, expiresAt])
  @@index([expiresAt])
  @@map("federation_idempotency_receipts")
}

model RegistryProjectionJournal {
  id                 String    @id @default(uuid())
  registryGeneration Int       @unique @map("registry_generation")
  sourceDigest       String    @map("source_digest")
  projectionDigest   String?   @map("projection_digest")
  state              String    @default("PREPARED")
  sanitizedErrorCode String?   @map("sanitized_error_code")
  committedAt        DateTime? @map("committed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([state, updatedAt])
  @@map("registry_projection_journal")
}

model RemoteEndpointCutover {
  id                 String    @id @default(uuid())
  remoteServerId     String    @map("remote_server_id")
  fromGeneration     Int       @map("from_generation")
  toGeneration       Int       @map("to_generation")
  state              String    @default("PREPARED")
  deadlineAt         DateTime  @map("deadline_at")
  activatedAt        DateTime? @map("activated_at")
  finalizedAt        DateTime? @map("finalized_at")
  rolledBackAt       DateTime? @map("rolled_back_at")
  sanitizedErrorCode String?   @map("sanitized_error_code")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  remoteServer RemoteServer @relation(fields: [remoteServerId], references: [id], onDelete: Cascade)

  @@index([remoteServerId, state])
  @@index([deadlineAt])
  @@map("remote_endpoint_cutovers")
}

model HealthCheckPing {
  id             String   @id @default(uuid())
  siteId         String   @map("site_id")
  siteDomainId   String?  @map("site_domain_id")
  reachable      Boolean
  statusCode     Int?     @map("status_code")
  responseTimeMs Int      @default(0) @map("response_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteDomain SiteDomain? @relation(fields: [siteDomainId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([siteDomainId, createdAt])
  @@map("health_check_pings")
}

model AiSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  claudeSessionId String   @unique @map("claude_session_id")
  title           String?
  cwd             String   @default("/")
  messages        String   @default("[]") // JSON array
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("ai_sessions")
}

// =============================================================================
// Auth (бывший Redis — теперь SQLite)
// =============================================================================

/// Blacklist refresh-токенов (замена Redis `bl:{jti}`).
/// `expiresAt` — момент, после которого запись можно удалять (cron-чистка).
model TokenBlacklist {
  jti       String   @id
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("token_blacklist")
}

/// Счётчик неудачных попыток логина по IP (замена Redis `login_attempts:{ip}`).
/// TTL 15 минут: при `expiresAt < now()` запись считается устаревшей.
model LoginAttempt {
  ip        String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("login_attempts")
}

/// Метаданные активных refresh-токенов для IP-binding и отзыва (замена Redis `rt:{jti}` + `sessions:{userId}`).
model Session {
  jti       String   @id
  userId    String   @map("user_id")
  ip        String
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Универсальный KV-стор для настроек панели (General tab в /settings).
/// Значение — JSON-строка, парсится на чтении.
model PanelSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("panel_settings")
}

/// Сингл-стоп конфиг Basic Auth (защита входа в панель через HTTP Basic).
/// В таблице всегда не более одной записи (id = '_').
model BasicAuthConfig {
  id           String   @id @default("_")
  enabled      Boolean  @default(false)
  username     String   @default("")
  passwordHash String   @default("") @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("basic_auth_config")
}

// =============================================================================
// DNS — управление DNS-записями через API внешних провайдеров.
// Креды провайдеров шифруются AES-256-GCM (master key из ENV DNS_CREDENTIAL_KEY).
// =============================================================================

/// Подключённый аккаунт DNS-провайдера (Cloudflare / Yandex Cloud / VK Cloud / Yandex 360).
/// `credentialsEnc` — base64(iv|tag|ciphertext) JSON-объекта со специфичными
/// для провайдера секретами (apiToken / serviceAccountKey / appCredential / oauthToken...).
model DnsProviderAccount {
  id             String    @id @default(uuid())
  type           String // CLOUDFLARE | YANDEX_CLOUD | VK_CLOUD | YANDEX_360
  label          String
  credentialsEnc String    @map("credentials_enc")
  // Yandex folderId / VK projectId / CF account-scope (опционально). Хранится
  // отдельно от credentialsEnc, чтобы UI мог показывать его без дешифровки.
  scopeId        String?   @map("scope_id")
  // Override базового URL DNS API (нужно для VK Cloud: их URL может меняться).
  apiBaseUrl     String?   @map("api_base_url")
  status         String    @default("ACTIVE") // ACTIVE | ERROR | UNAUTHORIZED
  lastError      String?   @map("last_error")
  lastSyncAt     DateTime? @map("last_sync_at")
  zonesCount     Int       @default(0) @map("zones_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  zones DnsZone[]

  @@map("dns_provider_accounts")
}

/// DNS-зона (домен) у внешнего провайдера. Зеркало стороннего ресурса:
/// `externalId` — id зоны у провайдера. Уникальна в рамках одного аккаунта.
model DnsZone {
  id              String    @id @default(uuid())
  accountId       String    @map("account_id")
  externalId      String    @map("external_id")
  domain          String // example.com (apex, без trailing dot)
  status          String    @default("ACTIVE")
  nameservers     String? // JSON array of NS hosts
  recordsCount    Int       @default(0) @map("records_count")
  recordsCachedAt DateTime? @map("records_cached_at")
  // Опциональная связь с сайтом панельки. SetNull при удалении сайта, чтобы
  // зону не потерять (она всё ещё существует у провайдера).
  linkedSiteId    String?   @map("linked_site_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  account    DnsProviderAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  linkedSite Site?              @relation(fields: [linkedSiteId], references: [id], onDelete: SetNull)
  records    DnsRecord[]

  @@unique([accountId, externalId])
  @@index([domain])
  @@map("dns_zones")
}

/// Кеш DNS-записей зоны. Истина — у провайдера; cache обновляется при refresh
/// и при mutation. Никогда не служит источником при несоответствии — UI всегда
/// может вызвать refresh, чтобы перезалить из upstream.
model DnsRecord {
  id         String   @id @default(uuid())
  zoneId     String   @map("zone_id")
  externalId String   @map("external_id")
  type       String // A | AAAA | CNAME | MX | TXT | NS | SRV | CAA
  // Относительное имя ("@" для apex, "www" и т.п.). Без trailing dot.
  name       String
  // Значение. Для multi-value (например VK/Yandex recordset) — JSON-массив.
  content    String
  ttl        Int
  priority   Int?
  // Cloudflare-only: orange-cloud (proxy через CF). null для остальных провайдеров.
  proxied    Boolean?
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  zone DnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, externalId])
  @@index([zoneId, type, name])
  @@map("dns_records")
}

// -----------------------------------------------------------------------------
// System migrations
// -----------------------------------------------------------------------------

/// Журнал применённых системных миграций.
/// Применяется runner'ом `node current/migrations/runner.js up` после `prisma migrate deploy`
/// при выполнении `make update`. Каждый файл в `migrations/system/<id>.{ts,js}` исполняется
/// один раз, дубль регистрируется по уникальному `id`. `checksum` — sha256 файла на момент
/// применения; если задним числом изменили — runner покажет warning.
model SystemMigration {
  id         String   @id // 2026-04-29-001-rename-public-to-www
  appliedAt  DateTime @default(now()) @map("applied_at")
  durationMs Int      @map("duration_ms")
  checksum   String // sha256 содержимого файла миграции
  ok         Boolean  @default(true)
  errorLog   String?  @map("error_log")

  @@map("system_migrations")
}

/// Текущее состояние процесса обновления панели (`make update` / UI button).
/// Один синглтон-ряд (id="current"). Используется как advisory lock —
/// если status=running и pid жив, второй запуск отклоняется.
/// История прошлых обновлений — в `panel_update_history`.
model PanelUpdateState {
  id           String    @id @default("current") // всегда "current"
  status       String    @default("idle") // idle | running | succeeded | failed | rolled_back
  fromVersion  String?   @map("from_version")
  toVersion    String?   @map("to_version")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  pid          Int? // pid running update.sh — для проверки живости
  currentStage String?   @map("current_stage") // preflight|snapshot|download|verify|migrate|build|switch|reload|healthcheck
  errorMessage String?   @map("error_message")
  logTail      String?   @map("log_tail") // последние 16 KB stdout/stderr

  @@map("panel_update_state")
}

model PanelUpdateHistory {
  id           String   @id @default(uuid())
  fromVersion  String?  @map("from_version")
  toVersion    String   @map("to_version")
  status       String // succeeded | failed | rolled_back
  startedAt    DateTime @map("started_at")
  finishedAt   DateTime @map("finished_at")
  durationMs   Int      @map("duration_ms")
  triggeredBy  String?  @map("triggered_by") // userId | "cli" | "cron"
  errorMessage String?  @map("error_message")

  @@index([startedAt])
  @@map("panel_update_history")
}

// =============================================================================
// System cron jobs — задачи в crontab пользователя `root`. Управление
// аналогично per-site CronJob, но scope = SYSTEM (вне привязки к Site).
// Используется для общесистемных задач (дисковые проверки, бэкапы хоста и т.п.)
// и для импорта root-крона при миграции с hostpanel.
// =============================================================================

model SystemCronJob {
  id           String    @id @default(uuid())
  name         String
  schedule     String // cron expression: "* * * * *"
  command      String
  status       String    @default("ACTIVE") // ACTIVE | DISABLED
  // Источник записи: MANUAL — оператор создал из UI; IMPORTED_HOSTPANEL —
  // строка пришла из hostpanel-миграции (отображается с пометкой в UI).
  source       String    @default("MANUAL")
  // Опциональный комментарий (одной строкой) — отображается под именем.
  comment      String?
  lastOutput   String?   @map("last_output")
  lastRunAt    DateTime? @map("last_run_at")
  lastExitCode Int?      @map("last_exit_code")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("system_cron_jobs")
}

// =============================================================================
// Hostpanel migration — перенос сайтов со старой "hostPanel" (компонент MODX)
// на slave-сервер meowbox. Двухуровневая модель:
//   - HostpanelMigration: один запуск (источник + целевой slave + общий статус)
//   - HostpanelMigrationItem: один сайт внутри запуска (план + статус + лог)
//
// Безопасность кредов: SSH/MySQL пароли источника шифруются AES-256-GCM
// ключом MIGRATION_SECRET (env, генерится system-миграцией). В UI пароли
// никогда не отображаются после ввода.
//
// Транзакционная семантика: каждый item — независимая псевдо-транзакция.
// На сбое — cleanup только артефактов с migrationId === currentId.
// =============================================================================

model HostpanelMigration {
  id           String    @id @default(uuid())
  // PLANNED — создан, ещё не запускался
  // DISCOVERING — идёт пробинг источника
  // READY — discovery закончен, оператор редактирует план
  // RUNNING — выполняется
  // DONE — все sайты успешно
  // FAILED — все упали или фатальная ошибка
  // PARTIAL — часть успешно, часть упала
  // CANCELLED — отменён оператором
  status       String    @default("PLANNED")
  // JSON: { host, port, sshUser, sshPassEnc, mysqlHost, mysqlPort, mysqlUser,
  //         mysqlPassEnc, hostpanelDb, hostpanelTablePrefix }
  // Пароли в *Enc — base64(iv|tag|ciphertext) под MIGRATION_SECRET.
  // Миграция всегда локальна слейву, на котором живёт эта запись (master
  // проксирует REST-запросы по `/proxy/{serverId}/...` в выбранный slave).
  source       String
  // JSON: snapshot источника на момент discover (sites[], manticore, php-versions, ...)
  // null до завершения discovery.
  discovery    String?
  totalSites   Int       @default(0) @map("total_sites")
  doneSites    Int       @default(0) @map("done_sites")
  failedSites  Int       @default(0) @map("failed_sites")
  // Append-only лог стрима. Хранится последние 500 KB.
  log          String    @default("")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdBy    String    @map("created_by") // User.id

  items HostpanelMigrationItem[]

  @@index([status])
  @@index([createdAt])
  @@map("hostpanel_migrations")
}

model HostpanelMigrationItem {
  id              String    @id @default(uuid())
  migrationId     String    @map("migration_id")
  // hostpanel sites.id (modx_host_hostpanel_sites.id) — на источнике
  sourceSiteId    Int       @map("source_site_id")
  // JSON: исходная строка (sftp_pass, mysql_pass извлечены отдельно в migration.source)
  sourceData      String    @map("source_data")
  // JSON: PlanItem (см. spec §6.3) — финальный план миграции этого сайта
  plan            String
  // PLANNED|RUNNING|DONE|FAILED|SKIPPED|CONFLICT
  status          String    @default("PLANNED")
  // FK на Site после успеха (null до DONE или при FAILED/SKIPPED)
  newSiteId       String?   @map("new_site_id")
  errorMsg        String?   @map("error_msg")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  // 0..100 — текущий прогресс (для rsync/dump — реальный, иначе round-up по стейджам)
  progressPercent Int       @default(0) @map("progress_percent")
  // Имя текущего стейджа: pre-flight | create-user | rsync-files | db-create | ...
  currentStage    String?   @map("current_stage")
  // Последние 200 KB лога этого item (rsync output, mysqldump errors etc.)
  log             String    @default("")

  migration HostpanelMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)

  @@index([migrationId])
  @@index([status])
  @@map("hostpanel_migration_items")
}

// Сохранённые пресеты подключения к источникам hostPanel. Оператор не должен
// каждый раз вбивать SSH/MySQL креды — выбрал из списка → форма
// заполнилась → жмём «Сканировать». Пароли шифруются тем же
// MIGRATION_SECRET'ом, что и в HostpanelMigration.source. Ни в каком виде
// в API наружу не отдаются — для запуска discovery фронт шлёт sourceId,
// бэкенд внутри подставляет креды.
model HostpanelMigrationSource {
  id                   String    @id @default(uuid())
  // Удобочитаемое имя в UI («vm120 prod», «backup-server» и т.п.).
  name                 String
  host                 String
  port                 Int       @default(22)
  sshUser              String    @map("ssh_user")
  sshPassEnc           String    @map("ssh_pass_enc") // base64 AES-256-GCM
  mysqlHost            String    @map("mysql_host")
  mysqlPort            Int       @default(3306) @map("mysql_port")
  mysqlUser            String    @map("mysql_user")
  mysqlPassEnc         String    @map("mysql_pass_enc")
  hostpanelDb          String    @map("hostpanel_db")
  hostpanelTablePrefix String    @map("hostpanel_table_prefix")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  // Когда последний раз через этот пресет запускали discovery — сортируем
  // по нему в UI, чтобы недавно использованные были сверху.
  lastUsedAt           DateTime? @map("last_used_at")
  createdBy            String    @map("created_by") // User.id

  // Уникальная пара host+sshUser+mysqlUser защищает от дублей при невнимательном
  // повторном сохранении того же сервера.
  @@unique([host, sshUser, mysqlUser])
  @@index([lastUsedAt])
  @@map("hostpanel_migration_sources")
}

// =============================================================================
// VPN Management
// См. docs/specs/2026-05-09-vpn-management.md
//
// Архитектурные пометки:
//   - Один сервис = одна VPN-инсталляция конкретного протокола на этом сервере
//     (на одном сервере может быть несколько сервисов разных протоколов и
//     разных портов одновременно).
//   - VpnUser — глобальная сущность панели; имеет subToken (per-user URL
//     подписки) и может состоять в N сервисах через VpnUserCreds (M:N).
//   - configBlob/credsBlob — base64 AES-256-GCM (vpn-cipher.ts).
// =============================================================================

model VpnService {
  id               String    @id @default(uuid())
  /// Произвольное имя сервиса для UI ("Reality Main", "Резервный WG", ...).
  /// Если null — UI рендерит "<protocol>:<port>".
  label            String?
  /// VpnProtocol enum: VLESS_REALITY | AMNEZIA_WG.
  protocol         String
  port             Int
  /// VpnServiceStatus enum: RUNNING | STOPPED | ERROR | DEPLOYING.
  status           String    @default("DEPLOYING")
  /// Сообщение об ошибке для статуса ERROR (показывается в UI).
  errorMessage     String?   @map("error_message")
  /// Зашифрованный JSON: VpnRealityServiceConfig | VpnAmneziaWgServiceConfig.
  /// Включает приватный ключ сервера + детали обфускации.
  configBlob       String    @map("config_blob")
  /// Только для VLESS_REALITY: SNI-маска отдельным полем для индексации
  /// и быстрого UI-рендера без дешифровки.
  sniMask          String?   @map("sni_mask")
  /// Результат последней автоматической проверки SNI (cron раз в 6 ч).
  sniLastCheckOk   Boolean?  @map("sni_last_check_ok")
  sniLastCheckedAt DateTime? @map("sni_last_checked_at")
  sniLastError     String?   @map("sni_last_error")
  /// Имя egress-интерфейса для AmneziaWG (eth0/ens3) — кешируем чтобы при
  /// рестарте/обновлении не считать заново.
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  userCreds VpnUserCreds[]

  @@unique([protocol, port])
  @@index([protocol])
  @@map("vpn_services")
}

model VpnUser {
  id        String   @id @default(uuid())
  /// Произвольное имя для UI и в комменте VLESS-URL/WG-конфига.
  /// Уникально per-panel (не per-service), так как юзер глобальный.
  name      String   @unique
  /// Random 32 bytes hex — токен для GET /api/vpn/sub/:token endpoint.
  /// Регенерируется по запросу (для отзыва доступа).
  subToken  String   @unique @map("sub_token")
  /// Глобальный enable/disable. Если false — все creds в свяках с сервисами
  /// удаляются из inbounds (xray) и peer'ов (wg) — но остаются в БД для
  /// возможного re-enable.
  enabled   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creds VpnUserCreds[]

  @@map("vpn_users")
}

/// Связка юзер-сервис: один юзер может быть в N сервисах одновременно
/// (например VLESS+Reality на 443/TCP и AmneziaWG на 51820/UDP).
/// При создании юзера в UI чек-боксами выбираем, в какие сервисы его положить.
model VpnUserCreds {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  serviceId String   @map("service_id")
  /// Зашифрованный JSON: VpnRealityUserCreds | VpnAmneziaWgUserCreds.
  credsBlob String   @map("creds_blob")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    VpnUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service VpnService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
  @@map("vpn_user_creds")
}

/// Master-owned stable public subscription. The public token is derived from
/// the master key and id; only its SHA-256 digest is persisted.
model FederatedVpnSubscription {
  id              String    @id @default(uuid())
  dedupeKey       String?   @unique @map("dedupe_key")
  tokenHash       String    @unique @map("token_hash")
  createdByUserId String    @map("created_by_user_id")
  state           String    @default("ACTIVE")
  maxStaleSeconds Int       @default(300) @map("max_stale_seconds")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy User                             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  sources   FederatedVpnSubscriptionSource[]

  @@index([createdByUserId, state, updatedAt])
  @@index([state, revokedAt])
  @@map("federated_vpn_subscriptions")
}

/// Explicit ordered target/user membership. `remoteServerId = null` is the
/// control-plane installation itself; targetInstallationId remains immutable.
model FederatedVpnSubscriptionSource {
  id                   String    @id @default(uuid())
  subscriptionId       String    @map("subscription_id")
  remoteServerId       String?   @map("remote_server_id")
  targetInstallationId String    @map("target_installation_id")
  vpnUserId            String    @map("vpn_user_id")
  position             Int
  state                String    @default("ACTIVE")
  invalidatedAt        DateTime? @map("invalidated_at")
  lastSuccessAt        DateTime? @map("last_success_at")
  lastFailureAt        DateTime? @map("last_failure_at")
  lastFailureCode      String?   @map("last_failure_code")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  subscription FederatedVpnSubscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  remoteServer RemoteServer?                   @relation(fields: [remoteServerId], references: [id], onDelete: SetNull)
  cache        FederatedVpnSubscriptionCache?

  @@unique([subscriptionId, targetInstallationId, vpnUserId])
  @@unique([subscriptionId, position])
  @@index([remoteServerId, state])
  @@index([targetInstallationId, state])
  @@index([vpnUserId])
  @@map("federated_vpn_subscription_sources")
}

/// Encrypted, target-signed source fragment. Cached plaintext never reaches
/// SQLite; the bounded stale window is enforced from generatedAt/validUntil.
model FederatedVpnSubscriptionCache {
  id            String    @id @default(uuid())
  sourceId      String    @unique @map("source_id")
  epoch         String
  payloadEnc    String    @map("payload_enc")
  fingerprint   String
  generatedAt   DateTime  @map("generated_at")
  validUntil    DateTime  @map("valid_until")
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  source FederatedVpnSubscriptionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([validUntil, invalidatedAt])
  @@index([fingerprint])
  @@map("federated_vpn_subscription_cache")
}

/// Master-owned opaque ingress route. The public token is derived from the
/// master key; only its digest and version are persisted. Provider verifier
/// material is encrypted and bound to this route ID.
model WebhookRoute {
  id                   String    @id @default(uuid())
  dedupeKey            String?   @unique @map("dedupe_key")
  tokenVersion         Int       @default(1) @map("token_version")
  tokenHash            String    @unique @map("token_hash")
  createdByUserId      String    @map("created_by_user_id")
  remoteServerId       String?   @map("remote_server_id")
  targetInstallationId String    @map("target_installation_id")
  targetSiteId         String    @map("target_site_id")
  targetDomainId       String    @map("target_domain_id")
  targetDomain         String    @map("target_domain")
  provider             String
  verifierEnc          String    @map("verifier_enc")
  state                String    @default("ACTIVE")
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  createdBy    User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  remoteServer RemoteServer?     @relation(fields: [remoteServerId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@index([createdByUserId, state, updatedAt])
  @@index([remoteServerId, state])
  @@index([targetInstallationId, state])
  @@map("webhook_routes")
}

/// Durable master delivery metadata. Provider bytes live only in the
/// encrypted filesystem spool; SQLite keeps hashes, claims, retry state, and
/// bounded results.
model WebhookDelivery {
  id                   String    @id @default(uuid())
  routeId              String    @map("route_id")
  providerDeliveryId   String    @map("provider_delivery_id")
  event                String
  bodySha256           String    @map("body_sha256")
  spoolRelativePath    String    @map("spool_relative_path")
  state                String    @default("ACCEPTED")
  attempt              Int       @default(0)
  maxAttempts          Int       @default(6) @map("max_attempts")
  availableAt          DateTime  @default(now()) @map("available_at")
  leaseOwner           String?   @map("lease_owner")
  leaseExpiresAt       DateTime? @map("lease_expires_at")
  lastAttemptAt        DateTime? @map("last_attempt_at")
  targetRequestId      String?   @map("target_request_id")
  result               String?
  lastErrorCode        String?   @map("last_error_code")
  acceptedAt           DateTime  @default(now()) @map("accepted_at")
  deliveredAt          DateTime? @map("delivered_at")
  dlqAt                DateTime? @map("dlq_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  route WebhookRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  @@unique([routeId, providerDeliveryId])
  @@index([state, availableAt, leaseExpiresAt])
  @@index([routeId, createdAt])
  @@index([dlqAt])
  @@map("webhook_deliveries")
}

/// Target-side durable receipt. It makes delivery replay safe even when the
/// master loses an acknowledgement and retries with a fresh transport
/// idempotency key.
model WebhookDeliveryReceipt {
  id                   String    @id @default(uuid())
  issuerInstallationId String    @map("issuer_installation_id")
  deliveryId           String    @map("delivery_id")
  routeId              String    @map("route_id")
  requestHash          String    @map("request_hash")
  state                String    @default("PROCESSING")
  deployId             String?   @map("deploy_id")
  result               String?
  lastErrorCode        String?   @map("last_error_code")
  receivedAt           DateTime  @default(now()) @map("received_at")
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([issuerInstallationId, deliveryId])
  @@index([routeId, receivedAt])
  @@index([state, updatedAt])
  @@map("webhook_delivery_receipts")
}
