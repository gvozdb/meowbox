{
  "name": "@meowbox/agent",
  "version": "0.1.0",
  "description": "Meowbox Server Agent — executes system commands",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node --transpile-only src/main.ts",
    "test:php-preflight": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/php-pool-preflight.test.js",
    "test:deploy-runtime": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/deploy-runtime.test.js",
    "test:backup-archive": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/backup-archive.test.js",
    "test:backup-restore-safety": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/backup-restore-safety.test.js",
    "test:restic-snapshot-validation": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/restic-snapshot-validation.test.js",
    "test:restic-restore-safety": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/restic-restore-safety.test.js",
    "test:restic-retention": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/restic-retention.test.js",
    "test:redis-executor": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/redis-executor.test.js",
    "test:minio-executor": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/minio-executor.test.js",
    "test:restore-validation": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/restore-validation.test.js",
    "test:application-root-preflight": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/application-root-preflight.test.js",
    "test:installer-fail-closed": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/site-installer-fail-closed.test.js",
    "test:xray-port-reservation": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/xray-port-reservation.test.js",
    "test:dashboard-diagnostics": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/dashboard-diagnostics.test.js",
    "test:database-import": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/database-import-stream.test.js",
    "test:agent-jobs": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/agent-job-runtime.test.js test/process-ownership.test.js test/ssl-manager-validation.test.js",
    "test:federation": "npm run build && TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register -r ../tools/register-shared-source.js test/agent-job-runtime.test.js test/process-ownership.test.js test/ssl-manager-validation.test.js test/panel-access-cutover.test.js test/durable-agent-actions.test.js test/node-quick-command.test.js test/database-import-stream.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-storage": "^3.1037.0",
    "node-pty": "^1.1.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
